{
	"extends": "../tsconfig.json",
	"include": [
		"./src/**/*.ts",
		"../prisma/.gen/**/*.ts",
		"../trpc/**/*.ts",
		"../types/**/*.ts",
		"../definitions/**/*.ts"
	],
	"compilerOptions": {
		"lib": ["ESNext"],
		"types": [ "node","vite/client"],
		"esModuleInterop": true,
		"isolatedModules": true,
		"composite": true,
	}
}
