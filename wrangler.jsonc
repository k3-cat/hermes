{
	"$schema": "https://www.unpkg.com/wrangler@latest/config-schema.json",

	"name": "hermes",
	"main": "./worker/src/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],

	"workers_dev": false,

	"placement": { "mode": "smart" },

	"assets": {
		"run_worker_first": ["/api/*", "/trpc/*"],
	},

	"d1_databases":[{
		"binding": "DB_D1",
		"database_id": "be4c5439-bb56-46bf-b3cc-8a54bf1c9fcf",
	}],

	"kv_namespaces": [
		{ "binding": "KV_AUTH", "id": "27f5d7a1e3974828826ec85a1e74ed72" },
		{ "binding": "KV_HRM", "id": "f2e685e4ffad481b8da804d1a7744811" },
	],

	"r2_buckets": [{ "binding": "R2_STATIC", "bucket_name": "static" }],

	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["grafana-traces"],
		},
		"logs": {
			"enabled": true,
			"destinations": ["grafana-logs"],
		},
	},
}
