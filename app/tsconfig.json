{
	"extends": "../tsconfig.json",
	"include": [
		"./src/**/*.ts",
		"./src/**/*.tsx",
		"../prisma/.gen/**/*.ts",
		"../trpc/**/*.ts",
		"../types/**/*.ts",
		"../definitions/**/*.ts"
	],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"types": ["vite/client"],
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"isolatedModules": true,
		"composite": true,

		"paths": {
			"#/*": ["../*"],
			"@/*": ["./src/*"],
			"$/*": ["../worker/src/*"],
		}
	}
}
